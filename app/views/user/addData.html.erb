<main class="flex-1 p-6 bg-gray-100 dark:bg-gray-900 min-h-screen">
  <% if flash[:pesan].present? %>
    <div class="mb-4 p-4 rounded bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200">
      <%= flash[:pesan].html_safe %>
    </div>
  <% end %>

  <!-- Breadcrumb -->
  <nav class="text-sm text-gray-600 dark:text-gray-300 mb-4">
    <ol class="list-reset flex">
      <li><span class="mr-2">👥 User Management</span></li>
      <li>/</li>
      <li class="ml-2 font-semibold text-blue-600 dark:text-blue-400">Tambah User</li>
    </ol>
  </nav>

  <!-- Form Card -->
  <div class="bg-white dark:bg-gray-800 rounded-xl shadow-md p-6 max-w-xl mx-auto">
    <h2 class="text-2xl font-bold mb-6 text-gray-800 dark:text-white">Tambah User Baru</h2>

    <%= form_tag("/user/create") do %>
      <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Username</label>
        <input type="text" name="username" class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white" required>
      </div>

      <div class="mb-6">
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Password</label>
        <input type="password" name="password" class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white" required>
      </div>

      <div class="flex justify-end">
        <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-5 py-2 rounded-lg shadow transition duration-150 ease-in-out">
          Simpan
        </button>
      </div>
    <% end %>
  </div>
</main>
