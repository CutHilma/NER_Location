<main class="w-full px-6 py-8">
  <% if flash[:pesan].present? %>
    <div class="bg-green-100 text-green-700 px-4 py-3 rounded mb-4">
      <%= flash[:pesan].html_safe %>
    </div>
  <% end %>

  <!-- Breadcrumb -->
  <nav class="text-sm text-gray-500 mb-6">
    <ol class="list-reset flex">
      <li>Dashboard</li>
      <li><span class="mx-2">/</span></li>
      <li class="text-gray-800 font-semibold">Manajemen User</li>
    </ol>
  </nav>

  <!-- Total Users Card -->
  <div class="mb-6">
    <div class="bg-blue-500 text-white p-6 rounded-lg shadow w-full sm:w-1/3">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-lg font-medium">Total User</p>
          <h2 class="text-3xl font-bold mt-1"><%= @user_item %></h2>
        </div>
        <svg class="w-10 h-10 opacity-30" fill="none" stroke="currentColor" stroke-width="2"
          viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round"
            d="M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m13-6.13a4 4 0 11-8 0 4 4 0 018 0zM9 7a4 4 0 100 8 4 4 0 000-8z" />
        </svg>
      </div>
    </div>
  </div>

  <!-- Table Card -->
  <div class="bg-white shadow rounded-lg overflow-hidden">
    <div class="flex items-center justify-between px-4 py-3 border-b">
      <h3 class="text-lg font-semibold">Daftar Pengguna</h3>
      <a href="/user/addData"
         class="inline-flex items-center px-3 py-2 bg-green-600 text-white text-sm font-medium rounded hover:bg-green-700">
        <i class="fa fa-plus mr-2"></i> Tambah User
      </a>
    </div>

    <!-- Tabel -->
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200 text-sm text-left">
        <thead class="bg-gray-100">
          <tr>
            <th class="px-4 py-2 font-semibold text-gray-600">#</th>
            <th class="px-4 py-2 font-semibold text-gray-600">Username</th>
            <th class="px-4 py-2 font-semibold text-gray-600">Dibuat Pada</th>
            <th class="px-4 py-2 text-center font-semibold text-gray-600">Aksi</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @userItem.each_with_index do |user, index| %>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-2"><%= index + 1 %></td>
              <td class="px-4 py-2"><%= user.username %></td>
              <td class="px-4 py-2"><%= user.created_at.strftime("%d %B %Y, %H:%M") %></td>
              <td class="px-4 py-2 text-center space-x-2">
                <a href="/user/editData/<%= user.id %>"
                   class="inline-block px-3 py-1 text-sm text-white bg-blue-500 rounded hover:bg-blue-600"
                   title="Edit">
                  <i class="fa fa-edit">Edit</i>
                </a>
                <a href="/user/delete/<%= user.id %>"
                   data-confirm="Yakin ingin menghapus user ini?"
                   class="inline-block px-3 py-1 text-sm text-white bg-red-500 rounded hover:bg-red-600"
                   onclick="return confirm('Yakin ingin menghapus user ini?')"
                   title="Hapus">
                  <i class="fa fa-trash">Hapus</i>
                </a>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</main>
