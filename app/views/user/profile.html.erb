<div class="max-w-xl mx-auto mt-10 p-6 bg-white shadow-md rounded-lg">
  <h2 class="text-2xl font-bold text-gray-800 mb-4">Profil Saya</h2>

  <%= form_with url: "/profile/update", method: "post", local: true do |f| %>
    <div class="mb-4">
      <label class="block text-gray-700 font-medium">Username</label>
      <%= text_field_tag :username, @user_item.username, class: "w-full px-4 py-2 border rounded-lg mt-1" %>
    </div>

    <div class="mb-4">
      <label class="block text-gray-700 font-medium">Password</label>
      <%= password_field_tag :password, @user_item.password, class: "w-full px-4 py-2 border rounded-lg mt-1" %>
    </div>

    <div class="flex justify-end">
      <%= submit_tag "Update Profil", class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold px-4 py-2 rounded" %>
    </div>
  <% end %>
</div>
