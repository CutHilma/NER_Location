<div class="max-w-2xl mx-auto mt-10 bg-white p-8 rounded-xl shadow-md">
  <h2 class="text-2xl font-bold text-gray-800 mb-6">📷 Scrape Instagram Caption</h2>

  <% if flash[:success] %>
    <div class="bg-green-100 text-green-800 px-4 py-2 rounded my-2">
      <%= flash[:success] %>
    </div>
  <% end %>

  <%= form_with url: scrape_instagram_scraper_index_path, method: :get, local: true do %>
    <div class="mb-4">
      <%= label_tag :url, "Masukkan URL Postingan Instagram:", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= text_field_tag :url, params[:url], class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" %>
    </div>
    <div>
      <%= submit_tag "Scrape", class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-2 rounded-lg" %>
    </div>
  <% end %>

  <% if @caption.present? %>
    <div class="mt-8 bg-gray-50 border border-gray-200 rounded-lg p-6">
      <h3 class="text-xl font-semibold text-gray-800 mb-2">📄 Caption Ditemukan:</h3>
      <p class="text-gray-700 mb-4"><%= @caption %></p>

      <h4 class="text-lg font-semibold text-gray-800 mt-4 mb-1">📍 Deteksi Lokasi:</h4>
      <p class="mb-2">
        <strong class="text-gray-700">Ada lokasi?</strong>
        <span class="<%= @has_location ? 'text-green-600' : 'text-red-600' %> font-semibold">
          <%= @has_location ? "✅ Ya" : "❌ Tidak" %>
        </span>
      </p>

      <p class="text-gray-700 font-medium">Entitas Lokasi Terdeteksi:</p>
      <% if @ner_entities.present? %>
        <ul class="list-disc list-inside text-gray-800 mt-1">
          <% @ner_entities.each do |loc| %>
            <li>📍 <%= loc %></li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-sm text-red-500 italic">Tidak ada entitas lokasi yang terdeteksi.</p>
      <% end %>

      <% if @ner_detail.present? %>
        <h5 class="mt-6 font-bold text-gray-800">🔬 Detail Deteksi:</h5>
        <ul class="mt-2 text-sm text-gray-700 space-y-1">
          <li><strong>From Keyword:</strong> <%= Array(@ner_detail[:locations_from_keywords]).join(", ").presence || "(tidak ada)" %></li>
          <li><strong>From Pattern:</strong> <%= Array(@ner_detail[:locations_from_pattern]).join(", ").presence || "(tidak ada)" %></li>
          <li><strong>From Structure:</strong> <%= Array(@ner_detail[:locations_from_structure]).join(", ").presence || "(tidak ada)" %></li>
          <li><strong>From Soft Match:</strong> <%= Array(@ner_detail[:location_possible]).join(", ").presence || "(tidak ada)" %></li>
        </ul>
      <% else %>
        <p class="text-sm text-red-500 italic mt-2">Detail deteksi tidak tersedia.</p>
      <% end %>
      <!-- FORM SAVE LABEL -->
      <div class="mt-8 border-t pt-6">
        <h4 class="text-lg font-bold text-gray-800 mb-3">
          💾 Save Label As
        </h4>

        <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-4 text-sm text-gray-700">
          <p><strong>Keterangan Label:</strong></p>
          <ul class="list-disc list-inside mt-1">
            <li><strong>0</strong> = Caption tidak mengandung entitas lokasi</li>
            <li><strong>1</strong> = Caption mengandung entitas lokasi</li>
          </ul>
        </div>

        <%= form_with url: save_label_instagram_scraper_index_path,
                      method: :post,
                      local: true do %>

          <%= hidden_field_tag :caption, @caption %>

          <div class="mb-4">
            <%= label_tag :label, "Pilih Label",
                class: "block text-sm font-medium text-gray-700 mb-1" %>

            <%= select_tag :label,
                options_for_select([
                  ['0 - Tidak Ada Lokasi', 0],
                  ['1 - Mengandung Lokasi', 1]
                ]),
                class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500" %>
          </div>

          <%= submit_tag "Simpan Dataset",
              class: "bg-green-600 hover:bg-green-700 text-white font-semibold px-6 py-2 rounded-lg" %>

        <% end %>
      </div>
    </div>
  <% end %>

</div>
