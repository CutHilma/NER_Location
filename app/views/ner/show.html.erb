<!-- Main Content -->
<main class="flex-1 px-6 py-8">
  <% if flash[:pesan].present? %>
    <div class="bg-green-100 border border-green-300 text-green-800 px-4 py-3 rounded mb-6">
      <%= flash[:pesan].html_safe %>
    </div>
  <% end %>

  <!-- Judul -->
  <h2 class="text-center text-xl md:text-2xl font-bold text-gray-800 mb-8 leading-relaxed">
    Hasil Penelitian Named Entity Lokasi dalam Postingan Teks Instagram Menggunakan Algoritma Support Vector Machine
  </h2>

  <!-- Card Container -->
  <div class="bg-white border border-gray-200 rounded-xl shadow-md p-6 max-w-full mx-auto space-y-8">
    <!-- Info Data -->
    <div>
      <h2 class="text-xl font-semibold text-gray-800 mb-2">Data Testing</h2>
      <p class="text-gray-600">
        Data testing yang digunakan adalah <span class="font-bold text-indigo-600">30%</span> dari total data.
      </p>
    </div>

    <!-- Confusion Matrix Table -->
    <div>
      <h2 class="text-xl font-semibold text-gray-800 mb-4">Confusion Metrics</h2>
      <div class="bg-gray-50 border border-gray-200 rounded-lg p-4 overflow-x-auto">
        <table class="min-w-full bg-white text-sm text-gray-800 border border-gray-300 rounded-lg shadow">
          <thead class="bg-gray-100 text-left">
            <tr>
              <th class="px-4 py-2 border"></th>
              <th class="px-4 py-2 border text-center">Predict: 1</th>
              <th class="px-4 py-2 border text-center">Predict: 0</th>
            </tr>
          </thead>
          <tbody>
            <tr class="hover:bg-gray-50">
              <th class="px-4 py-2 border font-medium">Actual: 1 (Contains Location)</th>
              <td class="px-4 py-2 border text-center"><%= @confusion[:tp] %></td>
              <td class="px-4 py-2 border text-center"><%= @confusion[:fn] %></td>
            </tr>
            <tr class="hover:bg-gray-50">
              <th class="px-4 py-2 border font-medium">Actual: 0 (No Location)</th>
              <td class="px-4 py-2 border text-center"><%= @confusion[:fp] %></td>
              <td class="px-4 py-2 border text-center"><%= @confusion[:tn] %></td>
            </tr>
            <%# Metrics %>
            <% [["Accuracy", @accuracy], ["Precision", @precision], ["Recall", @recall], ["F1-Score", @f1Score]].each do |name, value| %>
              <tr class="bg-rose-50">
                <th class="px-4 py-2 border font-medium"><%= name %></th>
                <td class="px-4 py-2 border text-center" colspan="2"><%= number_with_precision(value, precision: 2) %>%</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Statistik Ringkasan -->
    <div class="text-sm text-gray-700 mt-4">
      Total Caption: <%= @predicted_data.size %> |
      Prediksi Benar: <%= @predicted_data.count { |d| d[:label] == (d[:prediction] == "Contains Location" ? 1 : 0) } %>
      Akurasi Langsung: <%= number_with_precision(@predicted_data.count { |d| d[:label] == (d[:prediction] == "Contains Location" ? 1 : 0) }.to_f / @predicted_data.size * 100, precision: 2) %>%
    </div>

    <!-- Link ke Grafik Evaluasi -->
    <div class="text-center">
      <%= link_to "📊 Lihat Grafik Evaluasi", ner_show_grafik_path,
          class: "text-indigo-600 font-semibold hover:underline" %>
    </div>

    <!-- Header Prediksi -->
    <div class="text-center">
      <h2 class="text-2xl font-semibold text-gray-800">Hasil Prediksi Caption</h2>
      <p class="text-sm text-gray-500 mt-2">Berikut adalah hasil prediksi lokasi berdasarkan caption yang telah diproses.</p>
    </div>

    <!-- Tombol Download -->
    <div class="text-center space-x-4">
      <%= link_to "⬇️ Download CSV", export_predictions_csv_path,
          class: "inline-block bg-green-600 text-white font-semibold px-4 py-2 rounded hover:bg-green-700" %>
      <%= link_to "⬇️ Download Excel", export_predictions_excel_path,
          class: "inline-block bg-indigo-600 text-white font-semibold px-4 py-2 rounded hover:bg-indigo-700" %>
    </div>

    <!-- Tabel Prediksi -->
    <div class="overflow-x-auto">
      <table class="min-w-full table-auto text-sm text-gray-800 border border-gray-200 rounded-md shadow">
        <thead class="bg-gray-100 text-left text-gray-700">
          <tr>
            <th class="px-4 py-2 border">No</th>
            <th class="px-4 py-2 border">Caption</th>
            <th class="px-4 py-2 border">Before Label</th>
            <th class="px-4 py-2 border">Prediction Label</th>
            <th class="px-4 py-2 border">All Locations</th>
          </tr>
        </thead>
        <tbody>
          <% @predicted_data.each_with_index do |value, index| %>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-2 border text-center font-medium"><%= index + 1 %></td>
              <td class="px-4 py-2 border whitespace-pre-line break-words max-w-xs truncate"><%= value[:caption] %></td>
              <td class="px-4 py-2 border text-center"><%= value[:label] %></td>
              <td class="px-4 py-2 border text-center"><%= value[:prediction] %></td>
              <%# Helper untuk render lokasi ada di file application helper %>

          
              <td class="px-4 py-2 border"><%= render_locations(value[:all_locations]) %></td> 
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</main>

<!-- Footer -->
<%= render 'templates/footer' %>
