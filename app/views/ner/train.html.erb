

<%= render 'templates/header' %>
<%= render 'templates/sidebar' %>
      <!-- Main Content -->
      <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
          <%= flash[:pesan].html_safe if flash[:pesan].present? %>
          <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
              <li class="breadcrumb-item active" aria-current="page">SVM</li>
            </ol>
          </nav>
        <div class="card">
          <div class="card-header">
            <%# <a href="/data/addData" class="btn btn-primary btn-sm mb-2">Tambah Caption</a> %>
            <h1>Latih Model Klasifikasi Kalimat Lokasi</h1>

            <% if flash[:notice] %>
            <p style="color: green;"><%= flash[:notice] %></p>
            <% end %>

            <%= form_with url: ner_train_path, method: :post do %>
            <p>Tekan tombol di bawah untuk melatih ulang model menggunakan data terbaru.</p>
            <%= submit_tag "Latih Model", class: "btn btn-primary" %>
            <% end %>
          </div>
          <div class="card-body">
           
          </div>
        </div>
      </main>
    </div>
  </div>
<%= render 'templates/footer' %>
