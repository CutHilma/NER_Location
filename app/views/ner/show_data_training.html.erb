<div class="max-w-6xl mx-auto p-6 bg-white rounded-2xl shadow space-y-10">

  <!-- Judul -->
  <div class="text-center">
    <h2 class="text-2xl font-bold text-gray-800">📘 Data Latih dan Prediksi</h2>
    <p class="text-gray-600 mt-2">Total: <span class="font-semibold"><%= @predicted_training.count %></span> data</p>
  </div>

  <!-- Tabel Prediksi -->
  <div class="overflow-x-auto md:overflow-visible">
    <table class="table-auto w-full text-sm text-gray-800 border border-gray-200 rounded-lg overflow-hidden shadow">
      <thead class="bg-gray-100 text-gray-700 text-left">
        <tr>
          <th class="px-4 py-2 border">No</th>
          <th class="px-4 py-2 border">Caption</th>
          <th class="px-4 py-2 border">Label Awal</th>
          <th class="px-4 py-2 border">Prediksi</th>
        </tr>
      </thead>
      <tbody>
        <% @predicted_training.each_with_index do |item, i| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-2 border text-center"><%= i + 1 %></td>
            <td class="px-4 py-2 border max-w-[400px] break-words whitespace-normal"><%= item[:caption] %></td>
            <td class="px-4 py-2 border text-center"><%= item[:label] %></td>
            <td class="px-4 py-2 border text-center">
              <% if item[:prediction] == "Contains Location" %>
                <span class="inline-block bg-green-100 text-green-700 px-2 py-1 rounded text-xs font-medium">Contains Location</span>
              <% else %>
                <span class="inline-block bg-red-100 text-red-700 px-2 py-1 rounded text-xs font-medium">No Location</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <!-- Evaluasi -->
  <div class="bg-gray-50 border border-gray-200 rounded-lg p-6">
    <h3 class="text-lg font-semibold text-gray-800 mb-4">📊 Evaluasi Model (Data Latih)</h3>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
      <div class="bg-white p-4 border rounded shadow">
        <p class="text-sm text-gray-500">Akurasi</p>
        <p class="text-xl font-bold text-gray-800"><%= @training_metrics[:accuracy].round(2) %>%</p>
      </div>
      <div class="bg-white p-4 border rounded shadow">
        <p class="text-sm text-gray-500">Presisi</p>
        <p class="text-xl font-bold text-gray-800"><%= @training_metrics[:precision].round(2) %>%</p>
      </div>
      <div class="bg-white p-4 border rounded shadow">
        <p class="text-sm text-gray-500">Recall</p>
        <p class="text-xl font-bold text-gray-800"><%= @training_metrics[:recall].round(2) %>%</p>
      </div>
      <div class="bg-white p-4 border rounded shadow">
        <p class="text-sm text-gray-500">F1 Score</p>
        <p class="text-xl font-bold text-gray-800"><%= @training_metrics[:f1_score].round(2) %>%</p>
      </div>
    </div>
  </div>
</div>
