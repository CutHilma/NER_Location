
<%= render 'templates/header' %>
<%= render 'templates/sidebar' %>
      <!-- Main Content -->
      <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
          <%= flash[:pesan].html_safe if flash[:pesan].present? %>
          <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
              <li class="breadcrumb-item active" aria-current="page">Data</li>
            </ol>
          </nav>
        <div class="card">
          <div class="card-header">
            <a href="/data/addData" class="btn btn-primary btn-sm mb-2">Tambah Caption</a>
          </div>
          <div class="card-body">
            <table class="table table-bordered" id="myTable" width="100%" cellspacing="0">
            <thead>
                <tr>
                  <th scope="col"></th>
                  <th scope="col">Text Caption</th>
                  <th scope="col">Label</th>
                  <th class="text-center" scope="col">Aksi</th>
                </tr>
            </thead>
            <tbody>
                <% no = 1 %>
                <% @dataItem.each do |value|%>
                <tr>
                <th scope="row"><%= no %></th>
                <td><%= value['caption'] %></td>
                <td><%= value['label'] %></td>
                <td class="text-center">
                  <a href="/data/editData/<%= value.id %>" class="btn btn-sm btn-primary btn-block">
                    <i class="fa fa-edit"></i>
                  </a>
                  <a href="/data/delete/<%= value.id %>" class="btn btn-sm btn-danger btn-block" onclick="return confirm('Apakah anda yakin ingin menghapus?')">
                    <i class="fa fa-trash"></i>
                  </a>
                </td>
                </tr>
                <% no += 1 %>
                <%end%>
                
            </tbody>
        </table>
          </div>
        </div>
      </main>
    </div>
  </div>
<%= render 'templates/footer' %>
