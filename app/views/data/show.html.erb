<main class="flex-1 px-6 py-8">
  <% if flash[:pesan].present? %>
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-6">
      <%= flash[:pesan].html_safe %>
    </div>
  <% end %>

  <!-- Breadcrumb -->
  <nav class="text-sm text-gray-500 mb-4">
    <ol class="list-reset flex">
      <li><a href="/dashboard" class="hover:underline">Dashboard</a></li>
      <li class="mx-2">/</li>
      <li class="text-gray-700 font-semibold">Data</li>
    </ol>
  </nav>

  <%= link_to '⬇️ Download Caption CSV', export_csv_data_path, class: "bg-green-500 text-white px-4 py-2 rounded" %>
  <br>
  <br>  
  <!-- Info Box -->
  <div class="bg-green-50 border-l-4 border-green-400 text-green-700 p-4 mb-6 rounded shadow-sm">
    <p class="font-medium">Data Caption</p>
    <p>Total: <%= @data_item %></p>
  </div>

  <div class="max-w-6xl mx-auto px-4 py-8">
    <h2 class="text-3xl font-bold mb-6 text-center">Statistik Ringkas Dataset Caption</h2>

    <!-- Kartu Statistik -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
      <div class="bg-white p-6 shadow rounded-lg">
        <h3 class="text-lg font-semibold text-gray-700">Total Caption</h3>
        <p class="text-2xl font-bold text-blue-700"><%= @total_caption %></p>
      </div>
      <div class="bg-white p-4 rounded shadow">
        <h3 class="font-semibold">Caption Terpendek</h3>
        <p class="text-xl text-blue-700"><%= @min_length %> karakter</p>
      </div>
      <div class="bg-white p-4 rounded shadow">
        <h3 class="font-semibold">Caption Terpanjang</h3>
        <p class="text-xl text-blue-700"><%= @max_length %> karakter</p>
      </div>
      <div class="bg-white p-4 rounded shadow">
        <h3 class="font-semibold">Rata-rata Panjang Caption</h3>
        <p class="text-xl text-blue-700"><%= @avg_length %> karakter</p>
      </div>
      <div class="bg-white p-6 shadow rounded-lg">
        <h3 class="text-lg font-semibold text-gray-700">Label 1 (dengan lokasi)</h3>
        <p class="text-xl"><%= @jumlah_label_1 %> caption (<%= ((@jumlah_label_1.to_f / @total_caption) * 100).round %>%)</p>
      </div>
      <div class="bg-white p-6 shadow rounded-lg">
        <h3 class="text-lg font-semibold text-gray-700">Label 0 (tanpa lokasi)</h3>
        <p class="text-xl"><%= @jumlah_label_0 %> caption (<%= ((@jumlah_label_0.to_f / @total_caption) * 100).round %>%)</p>
      </div>
    </div>

    <!-- Chart Pie -->
    <div class="bg-white p-6 shadow rounded-lg">
      <h3 class="text-lg font-semibold text-gray-700 mb-4">Distribusi Label Caption</h3>
      <%= pie_chart @chart_data, height: "300px", library: {
        plotOptions: { pie: { dataLabels: { enabled: true, format: '{point.name}: {point.percentage:.1f}%' } } },
        legend: { enabled: true }
      } %>
    </div>
  </div>


  <% if current_user&.role == "admin" %>
  <!-- Add Caption -->
    <div class="mb-4">
      <a href="/data/addData" class="inline-block bg-blue-600 text-white px-4 py-2 rounded shadow hover:bg-blue-700 transition text-sm">
        + Tambah Caption
      </a>
    </div>
  <% end %>

  <!-- Data Table -->
  <div>
    <table class="w-full table-fixed border border-gray-200 rounded shadow-sm">
      <thead class="bg-gray-100 text-left text-gray-700">
        <tr>
          <th class="px-4 py-2">#</th>
          <th class="px-4 py-2">Text Caption</th>
          <th class="px-4 py-2">Label</th>
          <th class="px-4 py-2 text-center">Aksi</th>
        </tr>
      </thead>
      <tbody class="text-gray-800">
        <% no = 1 %>
        <% @dataItem.each do |value| %>
          <tr class="border-t hover:bg-gray-50">
            <td class="px-4 py-2 font-semibold"><%= no %></td>
            <td class="px-4 py-2 whitespace-pre-line"><%= value['caption'] %></td>
            <td class="px-4 py-2"><%= value['label'] %></td>
            <td class="px-4 py-2 text-center space-x-2">
              <% if current_user&.role == "admin" %>
                <div class="flex justify-center items-center gap-3">
                  <!-- Tombol Edit -->
                  <a href="/data/editData/<%= value.id %>" 
                    class="inline-flex items-center gap-2 bg-emerald-500 hover:bg-emerald-600 text-white text-sm px-3 py-1 rounded-lg shadow transition duration-200">
                    <svg class="w-4 h-4" ...></svg>
                    Edit
                  </a>

                  <!-- Tombol Hapus -->
                  <a href="/data/delete/<%= value.id %>" 
                    onclick="return confirm('Apakah anda yakin ingin menghapus?')"
                    class="inline-flex items-center gap-2 bg-rose-500 hover:bg-rose-600 text-white text-sm px-3 py-1 rounded-lg shadow transition duration-200">
                    <svg class="w-4 h-4" ...></svg>
                    Hapus
                  </a>
                </div>
              <% else %>
                <span class="text-gray-400 text-xs italic">Read only</span>
              <% end %>
            </td>
          </tr>
          <% no += 1 %>
        <% end %>
      </tbody>
    </table>
  </div>
</main>
<%= render 'templates/footer' %>
