<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Login Form</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
  .center-wrapper {
    display: flex;
    justify-content: center; /* center horizontally */
    align-items: center;     /* center vertically */
    height: 100vh;           /* full viewport height */
  }
</style>
</head>
<div class="center-wrapper">
  <div class="container" style="max-width: 400px; width: 100%;">
    <%= form_with url: login_path, method: :post, local: true do %>
      <div class="mb-3">
        <label for="username" class="form-label">Username</label>
        <%= text_field_tag :username, nil, class: 'form-control', placeholder: 'Enter username', required: true %>
      </div>
      <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <%= password_field_tag :password, nil, class: 'form-control', placeholder: 'Password', required: true %>
      </div>
      <%= submit_tag 'Login', class: 'btn btn-primary w-100' %>
    <% end %>
  </div>
</div>



<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
