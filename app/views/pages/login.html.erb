<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Login Form</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<%= form_with url: login_path, method: :post, local: true do %>
  <div class="mb-3">
    <label for="username" class="form-label">Username</label>
    <%= text_field_tag :username, nil, class: 'form-control', placeholder: 'Enter username', required: true %>
  </div>
  <div class="mb-3">
    <label for="password" class="form-label">Password</label>
    <%= password_field_tag :password, nil, class: 'form-control', placeholder: 'Password', required: true %>
  </div>
  <div class="mb-3 form-check">
    <input type="checkbox" class="form-check-input" id="remember">
    <label class="form-check-label" for="remember">Remember me</label>
  </div>
  <%= submit_tag 'Login', class: 'btn btn-primary w-100' %>
<% end %>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
