<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Support Vector Machine" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- AlpineJS -->
    <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Highcharts & Chartkick -->
    <script src="https://code.highcharts.com/highcharts.js"></script>
    <script src="https://unpkg.com/chartkick@4.1.1/dist/chartkick.min.js"></script>
    <script>Chartkick.use(Highcharts)</script>

    <style>[x-cloak] { display: none !important; }</style>
  </head>

  <body class="bg-gray-100 font-sans antialiased" x-data="{ sidebarOpen: false, submenu: { ner: false }, dark: false }">
    <!-- Flash Messages -->
    <% flash.each do |key, message| %>
      <% bg_color, text_color = case key.to_sym
        when :notice then ["bg-blue-100", "text-blue-700"]
        when :alert then ["bg-red-100", "text-red-700"]
        when :pesan then ["bg-green-100", "text-green-700"]
        else ["bg-gray-100", "text-gray-700"]
      end %>
      <div class="<%= bg_color %> border-l-4 px-4 py-3 shadow-md mb-4 <%= text_color %>">
        <%= message.html_safe %>
      </div>
    <% end %>

    <!-- Navbar -->
    <header class="fixed top-0 left-0 w-full bg-lime-800 text-white px-4 py-3 shadow z-50">
      <div class="max-w-7xl mx-auto flex justify-between items-center">
        <div class="text-lg font-semibold">📍 NER System</div>

        <!-- Mobile menu button -->
        <div class="md:hidden">
          <button id="mobile-menu-button" class="focus:outline-none">
            <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>

        <!-- Navbar Links -->
        <nav class="hidden md:flex space-x-6 text-sm font-medium items-center">
          <% unless current_user %>
            <%= link_to "Crawling", instagram_scraper_index_path, class: "hover:underline" %>
            <%= link_to "Data Caption", data_show_path, class: "hover:underline" %>
            <%= link_to "Daftar Lokasi", location_index_path, class: "hover:underline" %>
          <% end %>

          <% if current_user %>
            <span class="text-sm">👤 <%= current_user.username %></span>
            <%= link_to "Logout", logout_path, class: "bg-red-500 hover:bg-red-600 px-3 py-1 rounded text-white text-sm" %>
          <% else %>
            <%= link_to "Login Admin", login_path, class: "bg-white text-lime-800 px-3 py-1 rounded hover:bg-gray-100 text-sm" %>
          <% end %>
        </nav>
      </div>

      <!-- Mobile Menu Dropdown -->
      <div id="mobile-menu" class="hidden md:hidden px-4 pt-2 pb-4 space-y-2 text-sm font-medium">
        <% unless current_user %>
          <%= link_to "Crawling", instagram_scraper_index_path, class: "block hover:underline" %>
          <%= link_to "Data Caption", data_show_path, class: "block hover:underline" %>
          <%= link_to "Daftar Lokasi", location_index_path, class: "block hover:underline" %>
        <% end %>

        <% if current_user %>
          <div class="text-white">👤 <%= current_user.username %></div>
          <%= link_to "Logout", logout_path, class: "block bg-red-500 hover:bg-red-600 px-3 py-1 rounded text-white text-sm mt-2 w-max" %>
        <% else %>
          <%= link_to "Login Admin", login_path, class: "block bg-white text-lime-800 px-3 py-1 rounded hover:bg-gray-100 text-sm w-max" %>
        <% end %>
      </div>
    </header>

    <script>
      document.addEventListener("DOMContentLoaded", function () {
        const btn = document.getElementById("mobile-menu-button");
        const menu = document.getElementById("mobile-menu");

        btn.addEventListener("click", () => {
          menu.classList.toggle("hidden");
        });
      });
    </script>

    <!-- Main Layout Body -->
    <div class="pt-10 flex min-h-screen">
      <%# Sidebar conditionally rendered %>
      <% if current_user %>
        <%= render 'templates/sidebar' %>
      <% end %>

      <!-- Main content -->
      <div class="flex-1 flex flex-col">
        <main class="p-6">
          <%= yield %>
        </main>
      </div>
    </div>
  </body>
</html>