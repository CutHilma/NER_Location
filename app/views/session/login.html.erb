<body class="bg-gray-100 min-h-screen flex items-center justify-center">

  <div class="w-full max-w-md bg-white rounded-xl shadow-lg p-8">
    <h2 class="text-2xl font-bold text-center text-gray-800 mb-6">🔐 Login to NER System</h2>

    <% if flash[:alert] %>
      <div class="mb-4 text-sm text-red-600 text-center">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <%= form_with url: login_path, method: :post, local: true do %>
      <div class="mb-4">
        <label class="block text-gray-700 font-semibold mb-1">Username</label>
        <%= text_field_tag :username, nil, placeholder: "Enter username", required: true,
              class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400" %>
      </div>

      <div class="mb-6">
        <label class="block text-gray-700 font-semibold mb-1">Password</label>
        <%= password_field_tag :password, nil, placeholder: "Enter password", required: true,
              class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400" %>
      </div>

      <div>
        <%= submit_tag "Login", class: "w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-lg" %>
      </div>
    <% end %>
  </div>

</body>