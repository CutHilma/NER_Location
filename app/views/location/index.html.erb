<main class="flex-1 px-6 py-8">
  <% if flash[:pesan].present? %>
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-6">
      <%= flash[:pesan].html_safe %>
    </div>
  <% end %>

  <!-- Breadcrumb -->
  <nav class="text-sm text-gray-500 mb-6">
    <ol class="list-reset flex">
      <li class="text-gray-700 font-semibold">Data Lokasi</li>
    </ol>
  </nav>

  <!-- Card Container -->
  <div class="bg-white rounded-lg shadow-md border border-gray-200 p-6">
    <!-- Header -->
    <div class="flex justify-between items-center mb-4">
      <h2 class="text-xl font-semibold text-gray-800">Daftar Lokasi</h2>
      <a href="/location/addData" 
         class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-md text-sm shadow transition">
        + Tambah Lokasi
      </a>
    </div>

    <!-- Table -->
    <div class="overflow-x-auto">
      <table class="min-w-full border border-gray-200 rounded">
        <thead class="bg-gray-100 text-gray-700">
          <tr>
            <th class="px-4 py-2 border-b text-left w-12">#</th>
            <th class="px-4 py-2 border-b text-left">Lokasi</th>
            <th class="px-4 py-2 border-b text-center w-40">Aksi</th>
          </tr>
        </thead>
        <tbody class="text-gray-800">
          <% no = 1 %>
          <% @lokasi.each do |value| %>
            <tr class="border-t hover:bg-gray-50">
              <td class="px-4 py-2 font-medium"><%= no %></td>
              <td class="px-4 py-2"><%= value['lokasi'] %></td>
              <td class="px-4 py-2 text-center space-x-2">
                <!-- Tombol Edit -->
                <% if current_user&.role == "admin" %>
                  <a href="/location/editData/<%= value.id %>" 
                    class="inline-flex items-center gap-2 bg-emerald-500 hover:bg-emerald-600 text-white px-3 py-1 rounded-lg text-sm shadow transition">
                    <!-- SVG icon edit -->
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 4h10M11 4L4 20l-1 4 4-1L20 13M11 4l9 9" />
                    </svg>
                    Edit
                  </a>

                  <!-- Tombol Hapus -->
                  <a href="/location/delete/<%= value.id %>" 
                    onclick="return confirm('Apakah anda yakin ingin menghapus?')"
                    class="inline-flex items-center gap-2 bg-rose-500 hover:bg-rose-600 text-white px-3 py-1 rounded-lg text-sm shadow transition">
                    <!-- SVG icon trash -->
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M9 7h6m-2-2h-2m-4 0h12" />
                    </svg>
                    Hapus
                  </a>
                <% else %>
                  <span class="text-gray-400 text-xs italic">Read only</span>
                <% end %>
              </td>
            </tr>
            <% no += 1 %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</main>

<%= render 'templates/footer' %>
